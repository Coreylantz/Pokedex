{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // The scripts run under Node's own type stripping (`node scripts/x.ts`),
    // which resolves the real file, so their imports carry a .ts extension.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "types": ["node", "vite/client", "vite-plugin-pwa/client", "unplugin-icons/types/react"]
  },
  "include": ["src", "e2e", "scripts", "*.config.ts"]
}
