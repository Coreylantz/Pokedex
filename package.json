{
    "name":  "pokedex",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "packageManager":  "pnpm@11.22.0",
    "sideEffects":  [
                        "**/*.css"
                    ],
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "build:dex":  "node scripts/build-dex.ts",
                    "build:icons":  "node scripts/build-icons.ts",
                    "build:fonts":  "node scripts/build-fonts.ts",
                    "lint":  "oxlint \u0026\u0026 biome lint .",
                    "typecheck":  "tsc -p tsconfig.json",
                    "test":  "vitest run --project unit",
                    "test:stories":  "vitest run --project stories",
                    "test:e2e":  "playwright test",
                    "storybook":  "storybook dev -p 6006 --no-open",
                    "build:storybook":  "storybook build",
                    "size":  "size-limit",
                    "knip":  "knip",
                    "audit:deps":  "pnpm audit --prod \u0026\u0026 knip",
                    "audit":  "node scripts/audit.ts",
                    "vitals":  "node scripts/vitals.ts",
                    "coverage":  "node scripts/coverage.ts",
                    "jank":  "node scripts/scroll-jank.ts",
                    "cost":  "node scripts/runtime-cost.ts",
                    "css:audit":  "node scripts/css-audit.ts",
                    "diagnose":  "node scripts/diagnose-types.ts",
                    "verify":  "pnpm lint \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test \u0026\u0026 pnpm build \u0026\u0026 pnpm size \u0026\u0026 pnpm test:stories \u0026\u0026 pnpm test:e2e \u0026\u0026 pnpm vitals",
                    "lint:quality":  "biome lint ."
                },
    "dependencies":  {
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.13.0",
                            "@biomejs/biome":  "^2.5.8",
                            "@iconify-json/pixelarticons":  "^1.2.8",
                            "@playwright/test":  "^1.62.1",
                            "@size-limit/file":  "^13.0.3",
                            "@storybook/addon-a11y":  "^10.5.8",
                            "@storybook/addon-vitest":  "^10.5.8",
                            "@storybook/react-vite":  "^10.5.8",
                            "@svgr/core":  "^8.1.0",
                            "@svgr/plugin-jsx":  "^8.1.0",
                            "@types/node":  "^26.2.0",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.4",
                            "@vitest/browser":  "^4.1.10",
                            "@vitest/browser-playwright":  "^4.1.10",
                            "@vitest/coverage-v8":  "^4.1.10",
                            "axe-core":  "^4.13.0",
                            "jsdom":  "^30.0.1",
                            "knip":  "^6.32.2",
                            "lighthouse":  "^13.4.1",
                            "oxlint":  "^1.75.0",
                            "rollup-plugin-visualizer":  "^7.1.1",
                            "size-limit":  "^13.0.3",
                            "storybook":  "^10.5.8",
                            "subset-font":  "^2.5.0",
                            "typescript":  "^7.0.2",
                            "unplugin-icons":  "^23.0.1",
                            "vite":  "^8.2.0",
                            "vite-plugin-pwa":  "^1.3.0",
                            "vitest":  "^4.1.10",
                            "web-vitals":  "^6.1.1",
                            "workbox-window":  "^7.4.1"
                        }
}